{
  "name": "parava",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "shared",
    "pipeline",
    "worker",
    "site"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:create": "bun pipeline/src/db/cli.ts create",
    "db:load": "bun pipeline/src/db/cli.ts load",
    "db:check": "bun pipeline/src/db/cli.ts check",
    "db:report": "bun pipeline/src/db/cli.ts report",
    "db:ui": "bun pipeline/src/db/ui.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "typescript": "^6"
  }
}
