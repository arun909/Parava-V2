# Local settings for the monthly pipeline. Copy to .env (gitignored) and fill in.
# Bun loads .env automatically. In CI, set these as GitHub Actions secrets.

# xeno-canto API v3 key, for calls and songs.
XENO_CANTO_API_KEY=

# Cloudflare R2 (S3-compatible), for uploading exports to v/{run}/ and backing up .data/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=parava-files
