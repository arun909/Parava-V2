---
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { samplePlaces } from "../../lib/placeholder";
---

<Base title="Places">
  <PageHeader title="Places" lede="Every state and union territory." />
  <ul class="grid">
    {
      samplePlaces.map((p) => (
        <li class="placeholder">
          <a href={`/places/${p.code}/`}>{p.name}</a>
        </li>
      ))
    }
  </ul>
</Base>
